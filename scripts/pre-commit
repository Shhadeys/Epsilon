#!/bin/sh
# Regenerates js/changelog-data.js whenever CHANGELOG.md is part of the commit,
# so the site never has to fetch the changelog from GitHub at runtime.
#
# This file is tracked so it survives a fresh clone, but Git only runs hooks from
# .git/hooks (never versioned). To (re)install it after cloning:
#   cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

if git diff --cached --name-only | grep -q '^CHANGELOG\.md$'; then
    node scripts/build-changelog.js
    git add js/changelog-data.js
fi
