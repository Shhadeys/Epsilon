rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidMessage() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
    }

    // One-time claim on a username. Doc id is the lowercased username, so the
    // first successful create wins it -- any later attempt on the same id is
    // evaluated as an update, which is blocked below. This is the sole source
    // of truth for "is this username taken", not the free-text field on
    // users/{uid} (which a client could otherwise set to anything).
    match /usernames/{usernameLower} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Public profile per account. Used to resolve a uid to a username and to
    // search for a user by username when starting a DM. Only creatable once
    // the matching usernames/{usernameLower} claim above is owned by this uid,
    // so usernameLower here can never diverge from an actually-reserved name.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.size() >= 3
        && request.resource.data.usernameLower.size() <= 20
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Public chat wall -- any signed-in user can read and post.
    match /publicMessages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidMessage();
      allow update, delete: if false;
    }

    // Suggestion/bug-report mailbox from the About tab. Anyone can drop a note in --
    // no chat account required -- but nobody can read it back except via the Firebase
    // console (the site owner), so this is write-only from the client's perspective.
    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if request.resource.data.type in ['suggestion', 'bug']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && (request.resource.data.uid == null || request.resource.data.uid is string);
      allow update, delete: if false;
    }

    // Direct messages. Doc id is [uidA, uidB].sort().join('_').
    match /dms/{dmId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      // Members are fixed at creation -- this only permits touching updatedAt
      // and who sent the last message, never reassigning the conversation itself.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastSenderUid'])
        && request.resource.data.lastSenderUid == request.auth.uid;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.members;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.members
          && isValidMessage();
        allow update, delete: if false;
      }
    }

    // Invite-code private rooms.
    match /rooms/{roomId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerUid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 10
        && request.resource.data.code.size() <= 16;
      allow update: if isSignedIn() && (
        // Joining: add yourself to members, nothing else may change.
        (
          request.auth.uid in request.resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
        ) ||
        // Existing member bumping the last-activity marker after sending a message.
        (
          request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastSenderUid'])
          && request.resource.data.lastSenderUid == request.auth.uid
        )
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members
          && isValidMessage();
        allow update, delete: if false;
      }
    }

    // code -> roomId lookup used to join a room. Codes are the shared secret,
    // so listing the collection is disabled and only a direct get() is allowed.
    match /roomCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
